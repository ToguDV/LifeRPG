{
  "name": "liferpg-ui",
  "productName": "LifeRPG",
  "desktopName": "liferpg.desktop",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "An RPG-style to-do list: real-life tasks are written as quests and completed along a route the journal remembers.",
  "author": {
    "name": "ToguDV",
    "email": "timeofgetup@gmail.com"
  },
  "homepage": "https://github.com/ToguDV/LifeRPG",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ToguDV/LifeRPG.git"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:desktop": "node scripts/desktop-dev.mjs",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "pnpm build && electron-builder --publish never",
    "build:icon": "node scripts/render-icon.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint . && pnpm -s check:docs && pnpm -s check:type",
    "check:docs": "node scripts/check-docs.mjs",
    "check:type": "node scripts/check-type.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report node_modules/.cache/liferpg-playwright-report"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.1.0",
    "vitest": "^5.1.1"
  }
}
